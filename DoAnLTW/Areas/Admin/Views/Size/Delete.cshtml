@model DoAnLTW.Models.Size
@{
    ViewData["Title"] = "Xóa kích thước";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h1, h3, h4 {
        color: #FFD700; /* Gold heading */
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    h1 {
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    hr {
        border-color: #FFD700; /* Gold divider */
        margin: 20px 0;
    }

    /* Definition list styling */
    .dl-horizontal {
        background-color: #FFFFFF; /* White background */
        color: #000000; /* Black text */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        border: 1px solid #FFD700; /* Gold border */
    }

        .dl-horizontal dt {
            font-weight: 500;
            color: #000000; /* Black label text */
            margin-bottom: 5px;
        }

        .dl-horizontal dd {
            margin-bottom: 15px;
            color: #000000; /* Black value text */
        }

    /* Button styling */
    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black on hover */
            border-color: #FFD700;
            color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-secondary {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #333333; /* Darker black on hover */
            border-color: #FFD700;
            color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Animations */
    @@keyframes fadeInDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .dl-horizontal {
            padding: 15px;
        }

            .dl-horizontal dt, .dl-horizontal dd {
                font-size: 0.9rem;
            }

        .btn-danger, .btn-secondary {
            padding: 6px 12px;
            font-size: 0.9rem;
        }
    }
</style>

<div class="container-fluid">
    <h1>Xóa kích thước</h1>

    <h3>Bạn có chắc chắn muốn xóa kích thước này?</h3>
    <div class="row">
        <div class="col-md-6">
            <div class="dl-horizontal">
                <h4>Thông tin kích thước</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-3">Kích thước</dt>
                    <dd class="col-sm-9">@Html.DisplayFor(model => model.size)</dd>
                </dl>

                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" name="id" value="@Model.SizeId" />
                    @Html.AntiForgeryToken()
                    <div class="form-group text-center">
                        <input type="submit" value="Xóa" class="btn btn-danger" /> <i class="fas fa-trash"></i>
                        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>