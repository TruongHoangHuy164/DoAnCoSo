@using DoAnLTW.Extensions
@model DoAnLTW.Models.PetHotelBooking
@{
    ViewData["Title"] = "Xóa Đặt Phòng";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h2, h3 {
        color: #FFD700; /* Gold heading */
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    h2 {
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    h3 {
        margin-bottom: 15px;
    }

    /* Card styling */
    .card {
        background-color: #FFFFFF; /* White card background */
        color: #000000; /* Black text */
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        padding: 20px;
    }

    /* Definition list styling */
    .dl-horizontal dt {
        font-weight: 500;
        color: #000000; /* Black label text */
        margin-bottom: 5px;
    }

    .dl-horizontal dd {
        margin-bottom: 15px;
        color: #000000; /* Black value text */
    }

    /* Button styling */
    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-secondary {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Animations */
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .card

    {
        padding: 15px;
    }

    .dl-horizontal dt, .dl-horizontal dd {
        font-size: 0.9rem;
    }

    .btn-danger, .btn-secondary {
        padding: 6px 12px;
        font-size: 0.9rem;
    }

    h2, h3 {
        font-size: 1.5rem;
    }

    }
</style>

<div class="container-fluid">
    <h2>Xóa Đặt Phòng</h2>
    <h3>Bạn có chắc muốn xóa đặt phòng này?</h3>

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="dl-horizontal">
                    <dl class="row">
                        <dt class="col-sm-3">Mã Đặt Phòng</dt>
                        <dd class="col-sm-9">@Model.BookingId</dd>
                        <dt class="col-sm-3">Thú Cưng</dt>
                        <dd class="col-sm-9">@(Model.Pet?.Name ?? "Không rõ")</dd>
                        <dt class="col-sm-3">Phòng</dt>
                        <dd class="col-sm-9">@(Model.Room?.RoomNumber ?? "Không rõ") (@(Model.Room?.RoomType?.Name ?? "Không rõ"))</dd>
                        <dt class="col-sm-3">Ngày Bắt Đầu</dt>
                        <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-sm-3">Ngày Kết Thúc</dt>
                        <dd class="col-sm-9">@Model.EndDate.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-sm-3">Trạng Thái</dt>
                        <dd class="col-sm-9">@Model.Status.GetDisplayName()</dd>
                    </dl>
                    <form asp-action="Delete" asp-controller="PetHotelBooking" asp-area="Admin">
                        <input type="hidden" asp-for="BookingId" />
                        <div class="form-group text-center mt-3">
                            <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                            <a asp-action="Index" asp-controller="PetHotelBooking" asp-area="Admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay Lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>