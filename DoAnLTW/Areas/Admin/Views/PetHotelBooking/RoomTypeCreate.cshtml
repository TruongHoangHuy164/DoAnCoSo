@model DoAnLTW.Models.RoomType

@{
    ViewData["Title"] = "Tạo loại phòng mới";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<h2>Tạo loại phòng mới</h2>

<div class="card shadow-sm p-4">
    <form asp-action="RoomTypeCreate">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Description" class="control-label"></label>
            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="PricePerNight" class="control-label"></label>
            <input asp-for="PricePerNight" class="form-control" type="number" step="0.01" />
            <span asp-validation-for="PricePerNight" class="text-danger"></span>
        </div>
        <div class="form-group">
            <input type="submit" value="Tạo" class="btn btn-primary" />
            <a asp-action="RoomTypeIndex" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}