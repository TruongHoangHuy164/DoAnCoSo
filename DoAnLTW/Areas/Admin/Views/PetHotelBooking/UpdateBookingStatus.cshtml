@using DoAnLTW.Extensions
@model DoAnLTW.Models.PetHotelBooking

@{
    ViewData["Title"] = "Cập nhật trạng thái đặt phòng";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<h2>Cập nhật trạng thái đặt phòng</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="card shadow-sm p-4 mb-4">
    <h4 class="card-title">Thông tin đặt phòng</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Mã đặt phòng</dt>
        <dd class="col-sm-9">@Model.BookingId</dd>

        <dt class="col-sm-3">Thú cưng</dt>
        <dd class="col-sm-9">@(Model.Pet?.Name ?? "Không rõ")</dd>

        <dt class="col-sm-3">Phòng</dt>
        <dd class="col-sm-9">@(Model.Room?.RoomNumber ?? "Không rõ") (@(Model.Room?.RoomType?.Name ?? "Không rõ"))</dd>

        <dt class="col-sm-3">Ngày bắt đầu</dt>
        <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Ngày kết thúc</dt>
        <dd class="col-sm-9">@Model.EndDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Tổng giá</dt>
        <dd class="col-sm-9">@Model.TotalPrice.ToString("C")</dd>

        <dt class="col-sm-3">Trạng thái hiện tại</dt>
        <dd class="col-sm-9">@Model.Status.GetDisplayName()</dd>
    </dl>

    <form asp-action="UpdateBookingStatus">
        <input type="hidden" asp-for="BookingId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")"></div>
        <div class="form-group">
            <label for="Status" class="control-label">Trạng thái mới</label>
            <select name="status" class="form-control" asp-items="ViewBag.StatusList"></select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>
        <div class="form-group mt-3">
            <input type="submit" value="Cập nhật" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}