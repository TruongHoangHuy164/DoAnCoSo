@using DoAnLTW.Extensions
@model DoAnLTW.Models.PetHotelBooking

@{
    ViewData["Title"] = "Chi tiết đặt phòng";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<h2>Chi tiết đặt phòng</h2>

<div class="card shadow-sm p-4 mb-4">
    <h4 class="card-title">Thông tin đặt phòng</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Mã đặt phòng</dt>
        <dd class="col-sm-9">@Model.BookingId</dd>

        <dt class="col-sm-3">Thú cưng</dt>
        <dd class="col-sm-9">@(Model.Pet?.Name ?? "Không rõ")</dd>

        <dt class="col-sm-3">Phòng</dt>
        <dd class="col-sm-9">@(Model.Room?.RoomNumber ?? "Không rõ") (@(Model.Room?.RoomType?.Name ?? "Không rõ"))</dd>

        <dt class="col-sm-3">Ngày bắt đầu</dt>
        <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Ngày kết thúc</dt>
        <dd class="col-sm-9">@Model.EndDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Tổng giá</dt>
        <dd class="col-sm-9">@Model.TotalPrice.ToString("C")</dd>

        <dt class="col-sm-3">Trạng thái</dt>
        <dd class="col-sm-9">@Model.Status.GetDisplayName()</dd>

        <dt class="col-sm-3">Địa chỉ</dt>
        <dd class="col-sm-9">@(Model.Address ?? "Không có")</dd>

        <dt class="col-sm-3">Ghi chú</dt>
        <dd class="col-sm-9">@(Model.Note ?? "Không có")</dd>

        <dt class="col-sm-3">Ngày đặt</dt>
        <dd class="col-sm-9">@Model.BookingDate.ToString("dd/MM/yyyy HH:mm")</dd>
    </dl>

    @if (Model.Pet?.Images?.Any() == true)
    {
        <h5>Hình ảnh thú cưng</h5>
        <div class="row">
            @foreach (var image in Model.Pet.Images)
            {
                <div class="col-md-3 mb-3">
                    <img src="@image.ImageUrl" class="img-fluid rounded" alt="Hình ảnh thú cưng" style="max-height: 150px;" />
                </div>
            }
        </div>
    }
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.BookingId" class="btn btn-warning">Sửa</a>
    <a asp-action="Delete" asp-route-id="@Model.BookingId" class="btn btn-danger">Xóa</a>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
</div>