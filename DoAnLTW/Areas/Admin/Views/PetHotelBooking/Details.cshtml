@using DoAnLTW.Extensions
@model DoAnLTW.Models.PetHotelBooking
@{
    ViewData["Title"] = "Chi Tiết Đặt Phòng";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h2, h5 {
        color: #FFD700; /* Gold heading */
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    hr {
        border-color: #FFD700; /* Gold divider */
        margin: 20px 0;
    }

    /* Card styling */
    .card {
        background-color: #FFFFFF; /* White card background */
        color: #000000; /* Black text */
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        padding: 20px;
    }

    /* Definition list styling */
    .dl-horizontal dt {
        font-weight: 500;
        color: #000000; /* Black label text */
        margin-bottom: 5px;
    }

    .dl-horizontal dd {
        margin-bottom: 15px;
        color: #000000; /* Black value text */
    }

    /* Image styling */
    .img-fluid {
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 5px;
        transition: transform 0.3s ease;
        max-height: 150px;
        object-fit: cover;
    }

        .img-fluid:hover {
            transform: scale(1.05);
        }

    /* Button styling */
    .btn-warning {
        background-color: #FFD700; /* Gold background */
        border-color: #FFD700;
        color: #000000; /* Black text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-warning:hover {
            background-color: #E6C200; /* Darker gold */
            border-color: #E6C200;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-secondary {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Animations */
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .card

    {
        padding: 15px;
    }

    .dl-horizontal dt, .dl-horizontal dd {
        font-size: 0.9rem;
    }

    .img-fluid {
        max-height: 100px;
    }

    .btn-warning, .btn-danger, .btn-secondary {
        padding: 6px 12px;
        font-size: 0.9rem;
    }

    h2, h5 {
        font-size: 1.5rem;
    }

    }
</style>

<div class="container-fluid">
    <h2>Chi Tiết Đặt Phòng</h2>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="dl-horizontal">
                    <h5>Thông Tin Đặt Phòng</h5>
                    <hr />
                    <dl class="row">
                        <dt class="col-sm-3">Mã Đặt Phòng</dt>
                        <dd class="col-sm-9">@Model.BookingId</dd>
                        <dt class="col-sm-3">Thú Cưng</dt>
                        <dd class="col-sm-9">@(Model.Pet?.Name ?? "Không rõ")</dd>
                        <dt class="col-sm-3">Phòng</dt>
                        <dd class="col-sm-9">@(Model.Room?.RoomNumber ?? "Không rõ") (@(Model.Room?.RoomType?.Name ?? "Không rõ"))</dd>
                        <dt class="col-sm-3">Ngày Bắt Đầu</dt>
                        <dd class="col-sm-9">@Model.StartDate.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-sm-3">Ngày Kết Thúc</dt>
                        <dd class="col-sm-9">@Model.EndDate.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-sm-3">Tổng Giá</dt>
                        <dd class="col-sm-9">@Model.TotalPrice.ToString("C")</dd>
                        <dt class="col-sm-3">Trạng Thái</dt>
                        <dd class="col-sm-9">@Model.Status.GetDisplayName()</dd>
                        <dt class="col-sm-3">Địa Chỉ</dt>
                        <dd class="col-sm-9">@(Model.Address ?? "Không có")</dd>
                        <dt class="col-sm-3">Ghi Chú</dt>
                        <dd class="col-sm-9">@(Model.Note ?? "Không có")</dd>
                        <dt class="col-sm-3">Ngày Đặt</dt>
                        <dd class="col-sm-9">@Model.BookingDate.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                    @if (Model.Pet?.Images?.Any() == true)
                    {
                        <h5>Hình Ảnh Thú Cưng</h5>
                        <div class="row">
                            @foreach (var image in Model.Pet.Images)
                            {
                                <div class="col-md-3 mb-3">
                                    <img src="@image.ImageUrl" class="img-fluid" alt="Hình ảnh thú cưng" />
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="form-group text-center mt-4">
                <a asp-action="Edit" asp-controller="PetHotelBooking" asp-area="Admin" asp-route-id="@Model.BookingId" class="btn btn-warning"><i class="fas fa-edit"></i> Sửa</a>
                <a asp-action="Delete" asp-controller="PetHotelBooking" asp-area="Admin" asp-route-id="@Model.BookingId" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa</a>
                <a asp-action="Index" asp-controller="PetHotelBooking" asp-area="Admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay Lại</a>
            </div>
        </div>
    </div>
</div>