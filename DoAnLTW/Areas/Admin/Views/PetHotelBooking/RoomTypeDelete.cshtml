@model DoAnLTW.Models.RoomType
@{
    ViewData["Title"] = "Xóa Loại Phòng";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h2, h3 {
        color: #FFD700; /* Gold heading */
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    h2 {
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    h3 {
        margin-bottom: 15px;
    }

    /* Card styling */
    .card {
        background-color: #FFFFFF; /* White card background */
        color: #000000; /* Black text */
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        padding: 20px;
    }

    /* Definition list styling */
    .dl-horizontal dt {
        font-weight: 500;
        color: #000000; /* Black label text */
        margin-bottom: 5px;
    }

    .dl-horizontal dd {
        margin-bottom: 15px;
        color: #000000; /* Black value text */
    }

    /* Button styling */
    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

        .btn-danger:disabled {
            background-color: #666666; /* Gray background for disabled */
            border-color: #666666;
            color: #CCCCCC; /* Light gray text */
            cursor: not-allowed;
            opacity: 0.6;
        }

    .btn-secondary {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Alert styling */
    .alert-danger {
        background-color: #000000; /* Black background */
        color: #FFD700; /* Gold text */
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        animation: fadeIn 0.5s ease-in-out;
    }

    /* Animations */
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .card

    {
        padding: 15px;
    }

    .dl-horizontal dt, .dl-horizontal dd {
        font-size: 0.9rem;
    }

    .btn-danger, .btn-secondary {
        padding: 6px 12px;
        font-size: 0.9rem;
    }

    h2, h3 {
        font-size: 1.5rem;
    }

    .alert-danger {
        font-size: 0.9rem;
        padding: 10px;
    }

    }
</style>

<div class="container-fluid">
    <h2>Xóa Loại Phòng</h2>
    <h3>Bạn có chắc muốn xóa loại phòng này?</h3>

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="dl-horizontal">
                    <dl class="row">
                        <dt class="col-sm-3">Tên Loại Phòng</dt>
                        <dd class="col-sm-9">@Model.Name</dd>
                        <dt class="col-sm-3">Mô Tả</dt>
                        <dd class="col-sm-9">@Model.Description</dd>
                        <dt class="col-sm-3">Giá Mỗi Đêm</dt>
                        <dd class="col-sm-9">@Model.PricePerNight.ToString("C")</dd>
                    </dl>
                    @if (Model.Rooms.Any())
                    {
                        <div class="alert alert-danger" role="alert">
                            Không thể xóa loại phòng này vì có @Model.Rooms.Count phòng đang sử dụng.
                        </div>
                    }
                    <form asp-action="RoomTypeDelete" asp-controller="RoomType" asp-area="Admin">
                        <input type="hidden" asp-for="RoomTypeId" />
                        <div class="form-group text-center mt-3">
                            <button type="submit" class="btn btn-danger" @(Model.Rooms.Any() ? "disabled" : "")><i class="fas fa-trash"></i> Xóa</button>
                            <a asp-action="RoomTypeIndex" asp-controller="RoomType" asp-area="Admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay Lại</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>