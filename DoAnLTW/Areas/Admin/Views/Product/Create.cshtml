@model DoAnLTW.Models.Product
@{
    ViewData["Title"] = "Thêm Sản Phẩm Mới";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h2, h5 {
        color: #FFD700; /* Gold heading */
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    /* Form styling */
    .form-container {
        background-color: #FFFFFF; /* White form background */
        color: #000000; /* Black text */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        border: 1px solid #FFD700; /* Gold border */
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            color: #000000; /* Black label text */
            font-weight: 500;
            margin-bottom: 5px;
        }

    .form-control, .form-control-file {
        background-color: #F5F5F5; /* Light gray input background */
        border: 1px solid #000000; /* Black border */
        color: #000000; /* Black text */
        border-radius: 5px;
        padding: 8px;
    }

        .form-control:focus, .form-control-file:focus {
            border-color: #FFD700; /* Gold border on focus */
            box-shadow: 0 0 5px rgba(255, 215, 0, 0.5);
            background-color: #FFFFFF; /* White background on focus */
        }

    textarea.form-control {
        resize: vertical;
    }

    /* Table styling */
    .table {
        background-color: #FFFFFF; /* White table background */
        color: #000000; /* Black text */
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            background-color: #FFD700; /* Gold header background */
            color: #000000; /* Black header text */
            text-transform: uppercase;
            font-weight: bold;
            padding: 10px;
            border: 1px solid #000000;
        }

        .table td {
            padding: 10px;
            vertical-align: middle;
            border: 1px solid #000000;
        }

    /* Button styling */
    .btn-primary, .btn-success {
        background-color: #FFD700; /* Gold background */
        border-color: #FFD700;
        color: #000000; /* Black text */
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover, .btn-success:hover {
            background-color: #E6C200; /* Darker gold */
            border-color: #E6C200;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-secondary, .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover, .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Alert styling */
    .alert-success {
        background-color: #FFD700; /* Gold background */
        color: #000000; /* Black text */
        border-color: #FFD700;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        animation: fadeIn 0.5s ease-in-out;
    }

    .alert-danger {
        background-color: #000000; /* Black background */
        color: #FFD700; /* Gold text */
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        animation: fadeIn 0.5s ease-in-out;
    }

    /* Validation error styling */
    .text-danger {
        color: #FFD700 !important; /* Gold error text */
        font-size: 0.85rem;
    }

    .field-validation-error {
        display: block;
        margin-top: 5px;
    }

    /* Animations */
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .form-container

    {
        padding: 15px;
    }

    .form-group label {
        font-size: 0.9rem;
    }

    .form-control, .form-control-file {
        font-size: 0.9rem;
        padding: 6px;
    }

    .table th, .table td {
        padding: 8px;
        font-size: 0.9rem;
    }

    .btn-primary, .btn-success, .btn-secondary, .btn-danger {
        padding: 6px 12px;
        font-size: 0.9rem;
    }

    h2, h5 {
        font-size: 1.5rem;
    }

    .alert-success, .alert-danger {
        font-size: 0.9rem;
        padding: 10px;
    }

    }
</style>

<div class="container-fluid">
    <h2>Thêm Sản Phẩm Mới</h2>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["ErrorMessage"]</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger" role="alert">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="form-container">
                <form asp-action="Create" asp-controller="Product" asp-area="Admin" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group">
                        <label asp-for="Name" class="control-label">Tên Sản Phẩm</label>
                        <input asp-for="Name" class="form-control" placeholder="Nhập tên sản phẩm" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="control-label">Mô Tả Sản Phẩm</label>
                        <textarea asp-for="Description" class="form-control" rows="5" placeholder="Nhập mô tả sản phẩm"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CategoryId" class="control-label">Danh Mục</label>
                        <select asp-for="CategoryId" class="form-control" asp-items="ViewBag.Categories">
                            <option value="">-- Chọn danh mục --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="BrandId" class="control-label">Thương Hiệu</label>
                        <select asp-for="BrandId" class="form-control" asp-items="ViewBag.Brands">
                            <option value="">-- Chọn thương hiệu --</option>
                        </select>
                        <span asp-validation-for="BrandId" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <h5>Kích Thước và Giá</h5>
                        <table class="table table-bordered" id="sizeTable">
                            <thead>
                                <tr>
                                    <th>Kích Thước</th>
                                    <th>Số Lượng</th>
                                    <th>Giá (VNĐ)</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <select name="selectedSizes" class="form-control">
                                            @foreach (var size in ViewBag.Sizes)
                                            {
                                                <option value="@size.SizeId">@(size.size ?? "Không có tên")</option>
                                            }
                                        </select>
                                    </td>
                                    <td><input type="number" name="sizeQuantities" class="form-control" min="0" placeholder="Nhập số lượng" /></td>
                                    <td><input type="number" name="sizePrices" class="form-control" min="0" step="0.01" placeholder="Nhập giá" /></td>
                                    <td><button type="button" class="btn btn-danger remove-row">Xóa</button></td>
                                </tr>
                            </tbody>
                        </table>
                        <button type="button" class="btn btn-success" id="addSizeRow"><i class="fas fa-plus"></i> Thêm Kích Thước</button>
                    </div>
                    <div class="form-group">
                        <label>Thêm Hình Ảnh Sản Phẩm</label>
                        <input type="file" name="imageFiles" multiple class="form-control-file" accept=".jpg,.jpeg,.png,.gif" />
                        <small class="form-text text-muted">Chọn một hoặc nhiều hình ảnh (jpg, jpeg, png, gif).</small>
                    </div>
                    <div class="form-group text-center mt-3">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> Lưu Sản Phẩm</button>
                        <a asp-action="Index" asp-controller="Product" asp-area="Admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $("#addSizeRow").click(function () {
                var row = `
                    <tr>
                        <td>
                            <select name="selectedSizes" class="form-control">
        @foreach (var size in ViewBag.Sizes)
        {
                                        <option value="@size.SizeId">@(size.size ?? "Không có tên")</option>
        }
                            </select>
                        </td>
                        <td><input type="number" name="sizeQuantities" class="form-control" min="0" placeholder="Nhập số lượng" /></td>
                        <td><input type="number" name="sizePrices" class="form-control" min="0" step="0.01" placeholder="Nhập giá" /></td>
                        <td><button type="button" class="btn btn-danger remove-row">Xóa</button></td>
                    </tr>`;
                $("#sizeTable tbody").append(row);
            });

            $(document).on("click", ".remove-row", function () {
                if ($("#sizeTable tbody tr").length > 1) {
                    $(this).closest("tr").remove();
                }
            });
        });
    </script>
}