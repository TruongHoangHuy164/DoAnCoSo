@model DoAnLTW.Models.Product
@{
    ViewData["Title"] = "Xóa Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h2, h4 {
        color: #FFD700; /* Gold heading */
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    h2 {
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    h4.text-danger {
        color: #FFD700 !important; /* Gold warning text */
    }

    hr {
        border-color: #FFD700; /* Gold divider */
        margin: 20px 0;
    }

    /* Definition list styling */
    .dl-horizontal {
        background-color: #FFFFFF; /* White background */
        color: #000000; /* Black text */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        border: 1px solid #FFD700; /* Gold border */
    }

        .dl-horizontal dt {
            font-weight: 500;
            color: #000000; /* Black label text */
            margin-bottom: 5px;
        }

        .dl-horizontal dd {
            margin-bottom: 15px;
            color: #000000; /* Black value text */
        }

    /* Table styling */
    .table {
        background-color: #FFFFFF; /* White table background */
        color: #000000; /* Black text */
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            background-color: #FFD700; /* Gold header background */
            color: #000000; /* Black header text */
            text-transform: uppercase;
            font-weight: bold;
            padding: 10px;
            border: 1px solid #000000;
        }

        .table td {
            padding: 10px;
            vertical-align: middle;
            border: 1px solid #000000;
        }

    /* Image styling */
    img {
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 5px;
        transition: transform 0.3s ease;
        max-width: 100px;
        height: auto;
        object-fit: cover;
    }

        img:hover {
            transform: scale(1.1);
        }

    /* Button styling */
    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-secondary {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Animations */
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .dl-horizontal

    {
        padding: 15px;
    }

    .dl-horizontal dt, .dl-horizontal dd {
        font-size: 0.9rem;
    }

    .table th, .table td {
        padding: 8px;
        font-size: 0.9rem;
    }

    img {
        max-width: 80px;
    }

    .btn-danger, .btn-secondary {
        padding: 6px 12px;
        font-size: 0.9rem;
    }

    h2, h4 {
        font-size: 1.5rem;
    }

    }
</style>

<div class="container-fluid">
    <h2>Xóa Sản Phẩm</h2>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="dl-horizontal">
                <h4 class="text-danger">Bạn có chắc chắn muốn xóa sản phẩm này?</h4>
                <hr />
                <dl class="row">
                    <dt class="col-sm-3">Tên Sản Phẩm</dt>
                    <dd class="col-sm-9">@Model.Name</dd>
                    <dt class="col-sm-3">Mô Tả</dt>
                    <dd class="col-sm-9">@Model.Description</dd>
                    <dt class="col-sm-3">Thương Hiệu</dt>
                    <dd class="col-sm-9">@(Model.Brand != null ? Model.Brand.Name : "Không có thương hiệu")</dd>
                    <dt class="col-sm-3">Danh Mục</dt>
                    <dd class="col-sm-9">@(Model.Category != null ? Model.Category.Name : "Không có danh mục")</dd>
                    <dt class="col-sm-3">Kích Thước & Giá</dt>
                    <dd class="col-sm-9">
                        @if (Model.ProductSizes != null && Model.ProductSizes.Any())
                        {
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Kích Thước</th>
                                        <th>Số Lượng Tồn Kho</th>
                                        <th>Giá (VNĐ)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ps in Model.ProductSizes)
                                    {
                                        <tr>
                                            <td>@(ps.Size != null ? ps.Size.size : "Không xác định")</td>
                                            <td>@ps.Stock</td>
                                            <td>@ps.Price.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <span>Chưa có thông tin kích thước</span>
                        }
                    </dd>
                    <dt class="col-sm-3">Hình Ảnh</dt>
                    <dd class="col-sm-9">
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            foreach (var img in Model.Images)
                            {
                                <img src="@img.ImageUrl" alt="Hình ảnh sản phẩm" />
                            }
                        }
                        else
                        {
                            <span>Chưa có hình ảnh</span>
                        }
                    </dd>
                </dl>
                <form asp-action="DeleteConfirmed" asp-controller="Product" asp-area="Admin" method="post">
                    <input type="hidden" name="id" value="@Model.ProductId" />
                    <div class="form-group text-center mt-3">
                        <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                        <a asp-action="Index" asp-controller="Product" asp-area="Admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay Lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>