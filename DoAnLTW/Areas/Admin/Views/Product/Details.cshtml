@model DoAnLTW.Models.Product
@{
    ViewData["Title"] = "Chi Tiết Sản Phẩm";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h2 {
        color: #FFD700; /* Gold heading */
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    /* Card styling */
    .card {
        background-color: #FFFFFF; /* White card background */
        color: #000000; /* Black text */
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
    }

    .card-body {
        padding: 20px;
    }

    /* Form group styling */
    .form-group label {
        color: #000000; /* Black label text */
        font-weight: 500;
        margin-bottom: 5px;
    }

    .form-control-static {
        color: #000000; /* Black text */
        padding: 8px;
        background-color: #F5F5F5; /* Light gray background */
        border: 1px solid #000000; /* Black border */
        border-radius: 5px;
    }

    /* Table styling */
    .table {
        background-color: #FFFFFF; /* White table background */
        color: #000000; /* Black text */
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            background-color: #FFD700; /* Gold header background */
            color: #000000; /* Black header text */
            text-transform: uppercase;
            font-weight: bold;
            padding: 10px;
            border: 1px solid #000000;
        }

        .table td {
            padding: 10px;
            vertical-align: middle;
            border: 1px solid #000000;
        }

    /* Image styling */
    img {
        border: 1px solid #FFD700; /* Gold border */
        border-radius: 5px;
        transition: transform 0.3s ease;
        max-width: 100px;
        height: auto;
        object-fit: cover;
    }

        img:hover {
            transform: scale(1.1);
        }

    /* Button styling */
    .btn-secondary {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-warning {
        background-color: #FFD700; /* Gold background */
        border-color: #FFD700;
        color: #000000; /* Black text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-warning:hover {
            background-color: #E6C200; /* Darker gold */
            border-color: #E6C200;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Animations */
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .card

    {
        padding: 15px;
    }

    .form-group label, .form-control-static {
        font-size: 0.9rem;
    }

    .table th, .table td {
        padding: 8px;
        font-size: 0.9rem;
    }

    img {
        max-width: 80px;
    }

    .btn-secondary, .btn-warning, .btn-danger {
        padding: 6px 12px;
        font-size: 0.9rem;
    }

    h2 {
        font-size: 1.5rem;
    }

    }
</style>

<div class="container-fluid">
    <h2>Chi Tiết Sản Phẩm</h2>

    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-body">
                    <div class="form-group mb-3">
                        <label class="control-label">Tên Sản Phẩm</label>
                        <p class="form-control-static">@Model.Name</p>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Mô Tả Sản Phẩm</label>
                        <p class="form-control-static">@Model.Description</p>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Thương Hiệu</label>
                        <p class="form-control-static">@(Model.Brand != null ? Model.Brand.Name : "Không có thương hiệu")</p>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Danh Mục</label>
                        <p class="form-control-static">@(Model.Category != null ? Model.Category.Name : "Không có danh mục")</p>
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Kích Thước, Số Lượng và Giá</label>
                        @if (Model.ProductSizes != null && Model.ProductSizes.Any())
                        {
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Kích Thước</th>
                                        <th>Số Lượng Tồn Kho</th>
                                        <th>Giá (VNĐ)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ps in Model.ProductSizes)
                                    {
                                        <tr>
                                            <td>@(ps.Size != null ? ps.Size.size : "Không xác định")</td>
                                            <td>@ps.Stock</td>
                                            <td>@ps.Price.ToString("N0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="form-control-static">Chưa có thông tin kích thước</p>
                        }
                    </div>
                    <div class="form-group mb-3">
                        <label class="control-label">Hình Ảnh</label>
                        @if (Model.Images != null && Model.Images.Any())
                        {
                            <div>
                                @foreach (var img in Model.Images)
                                {
                                    <img src="@img.ImageUrl" alt="Hình ảnh sản phẩm" />
                                }
                            </div>
                        }
                        else
                        {
                            <p class="form-control-static">Chưa có hình ảnh</p>
                        }
                    </div>
                </div>
            </div>
            <div class="form-group text-center mt-4">
                <a asp-action="Index" asp-controller="Product" asp-area="Admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay Lại</a>
                <a asp-action="Edit" asp-controller="Product" asp-area="Admin" asp-route-id="@Model.ProductId" class="btn btn-warning"><i class="fas fa-edit"></i> Sửa</a>
                <a asp-action="Delete" asp-controller="Product" asp-area="Admin" asp-route-id="@Model.ProductId" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa</a>
            </div>
        </div>
    </div>
</div>