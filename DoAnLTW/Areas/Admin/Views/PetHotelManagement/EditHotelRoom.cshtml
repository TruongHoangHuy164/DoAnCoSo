@model DoAnLTW.Models.HotelRoom

@{
    ViewData["Title"] = "Sửa Phòng";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<h2>Sửa Phòng</h2>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="EditHotelRoom">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="RoomId"/>
    <input
    <div class="form-group mb-3">
        <label asp-for="RoomNumber" class="control-label"></label>
        <input asp-for="RoomNumber" class="form-control" />
        <span asp-validation-for="RoomNumber" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="RoomTypeId" class="control-label"></label>
        <select asp-for="RoomTypeId" class="form-control" asp-items="ViewBag.RoomTypes"></select>
        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
    </div>
    <div class="form-group mb-3">
        <label asp-for="IsAvailable" class="control-label"></label>
        <select asp-for="IsAvailable" class="form-control">
            <option value="Available">Có Sẵn</option>
            <option value="Occupied">Đã Chiếm</option>
            <option value="Maintenance">Bảo Trì</option>
        </select>
        <span asp-validation-for="IsAvailable" class="text-danger"></span>
    </div>
    <div class="form-group">
        <input type="submit" value="Lưu" class="btn btn-primary" />
        <a asp-action="HotelRooms" class="btn btn-secondary">Quay Lại</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}