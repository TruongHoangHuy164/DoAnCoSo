@model DoAnLTW.Models.Service
@{
    ViewData["Title"] = "Xóa Dịch Vụ";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h2 {
        color: #FFD700; /* Gold heading */
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    hr {
        border-color: #FFD700; /* Gold divider */
        margin: 20px 0;
    }

    /* Form styling */
    .form-container {
        background-color: #FFFFFF; /* White form background */
        color: #000000; /* Black text */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        border: 1px solid #FFD700; /* Gold border */
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            color: #000000; /* Black label text */
            font-weight: 500;
            margin-bottom: 5px;
        }

    .form-control {
        background-color: #F5F5F5; /* Light gray input background */
        border: 1px solid #000000; /* Black border */
        color: #000000; /* Black text */
        border-radius: 5px;
        padding: 8px;
    }

        .form-control[readonly] {
            background-color: #E9ECEF; /* Slightly darker gray for readonly */
            opacity: 1;
        }

    textarea.form-control {
        resize: vertical;
    }

    /* Alert styling */
    .alert-warning {
        background-color: #FFD700; /* Gold background */
        color: #000000; /* Black text */
        border-color: #FFD700;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 20px;
        animation: fadeIn 0.5s ease-in-out;
    }

    /* Button styling */
    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-secondary {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Animations */
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    @@keyframes fadeIn {
        from

    {
        opacity: 0;
        transform: translateY(-10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .form-container

    {
        padding: 15px;
    }

    .form-group label {
        font-size: 0.9rem;
    }

    .form-control {
        font-size: 0.9rem;
        padding: 6px;
    }

    .btn-danger, .btn-secondary {
        padding: 6px 12px;
        font-size: 0.9rem;
    }

    h2 {
        font-size: 1.5rem;
    }

    .alert-warning {
        font-size: 0.9rem;
        padding: 10px;
    }

    }
</style>

<div class="container-fluid">
    <h2>Xóa Dịch Vụ</h2>

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="form-container">
                <div class="alert alert-warning">
                    Bạn có chắc chắn muốn xóa dịch vụ này?
                </div>
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="ServiceId" />
                    <div class="form-group">
                        <label asp-for="Name" class="control-label">Tên Dịch Vụ</label>
                        <input asp-for="Name" class="form-control" readonly />
                    </div>
                    <div class="form-group">
                        <label asp-for="Description" class="control-label">Mô Tả</label>
                        <textarea asp-for="Description" class="form-control" rows="3" readonly></textarea>
                    </div>
                    <div class="form-group">
                        <label asp-for="Price" class="control-label">Giá (VNĐ)</label>
                        <input asp-for="Price" class="form-control" type="number" step="1000" readonly />
                    </div>
                    <div class="form-group text-center mt-3">
                        <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa Dịch Vụ</button>
                        <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay Lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>