@model DoAnLTW.Models.Category
@{
    ViewData["Title"] = "Xóa Danh Mục";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h1 {
        color: #FFD700; /* Gold heading */
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
        text-align: center;
        text-transform: uppercase;
        animation: fadeInDown 0.5s ease-in-out;
    }

    p {
        color: #FFFFFF; /* White text */
        font-size: 1.1rem;
        margin-bottom: 15px;
    }

    /* Container styling */
    .delete-container {
        background-color: #FFFFFF; /* White background */
        color: #000000; /* Black text */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        border: 1px solid #FFD700; /* Gold border */
    }

    /* Image styling */
    img {
        border-radius: 5px;
        border: 1px solid #000000; /* Black border */
        margin-top: 10px;
    }

    /* Button styling */
    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    .btn-secondary {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
        padding: 8px 16px;
        border-radius: 5px;
        transition: all 0.3s ease;
    }

        .btn-secondary:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            color: #FFD700;
            box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        }

    /* Animations */
    @@keyframes fadeInDown {
        from

    {
        opacity: 0;
        transform: translateY(-20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .delete-container

    {
        padding: 15px;
    }

    p {
        font-size: 1rem;
    }

    .btn-danger, .btn-secondary {
        padding: 6px 12px;
        font-size: 0.9rem;
    }

    img {
        width: 120px;
        height: auto;
    }

    }
</style>

<div class="container-fluid">
    <h1>Xóa Danh Mục</h1>

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="delete-container">
                <p>Bạn có chắc chắn muốn xóa danh mục <strong>@Model.Name</strong>?</p>
                @if (!string.IsNullOrEmpty(Model?.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Name" style="width:150px; height:auto;" />
                }
                else
                {
                    <p>Không có hình ảnh</p>
                }

                <form asp-action="DeleteConfirmed" asp-controller="Category" asp-area="Admin" method="post">
                    <input type="hidden" name="id" value="@Model.CategoryId" />
                    <div class="form-group text-center mt-3">
                        <button type="submit" class="btn btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                        <a asp-action="Index" asp-controller="Category" asp-area="Admin" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>