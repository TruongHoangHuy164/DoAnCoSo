@model List<DoAnLTW.Models.PromotionCode>
@{
    ViewData["Title"] = "Quản lý Khuyến Mãi";
    Layout = "~/Areas/Admin/Views/Shared/layoutAdmin.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
    /* General page styling */
    body {
        background-color: #000000; /* Black background */
        color: #FFFFFF; /* White text */
        font-family: 'Arial', sans-serif;
    }

    h2 {
        color: #FFD700; /* Gold heading */
        border-bottom: 2px solid #FFD700;
        padding-bottom: 10px;
        margin-bottom: 20px;
    }

    /* Table styling */
    .table {
        background-color: #FFFFFF; /* White table background */
        color: #000000; /* Black text */
        border: 1px solid #FFD700; /* Gold border */
    }

        .table th {
            background-color: #FFD700; /* Gold header background */
            color: #000000; /* Black header text */
            border: 1px solid #000000; /* Black borders */
            padding: 12px;
            text-align: center;
        }

        .table td {
            border: 1px solid #000000; /* Black borders */
            padding: 10px;
            vertical-align: middle;
        }

        .table tr:nth-child(even) {
            background-color: #F5F5F5; /* Light gray for alternating rows */
        }

        .table tr:hover {
            background-color: #FFD70033; /* Light gold hover effect */
        }

    /* Button styling */
    .btn-primary {
        background-color: #FFD700; /* Gold background */
        border-color: #FFD700;
        color: #000000; /* Black text */
        font-weight: 600;
    }

        .btn-primary:hover {
            background-color: #E6C200; /* Darker gold on hover */
            border-color: #E6C200;
            color: #000000;
        }

    .btn-warning {
        background-color: #FFD700; /* Gold background */
        border-color: #FFD700;
        color: #000000; /* Black text */
    }

        .btn-warning:hover {
            background-color: #E6C200; /* Darker gold */
            border-color: #E6C200;
            color: #000000;
        }

    .btn-danger {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
    }

        .btn-danger:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            color: #FFD700;
        }

    .btn-success {
        background-color: #000000; /* Black background */
        border-color: #FFD700; /* Gold border */
        color: #FFD700; /* Gold text */
    }

        .btn-success:hover {
            background-color: #333333; /* Darker black */
            border-color: #FFD700;
            color: #FFD700;
        }

    /* Badge styling */
    .badge-success {
        background-color: #FFD700; /* Gold background */
        color: #000000; /* Black text */
        padding: 6px 10px;
        font-size: 0.85rem;
    }

    .badge-danger {
        background-color: #000000; /* Black background */
        color: #FFD700; /* Gold text */
        border: 1px solid #FFD700; /* Gold border */
        padding: 6px 10px;
        font-size: 0.85rem;
    }

    /* Alert styling */
    .alert-success {
        background-color: #FFD700; /* Gold background */
        color: #000000; /* Black text */
        border-color: #FFD700;
        font-weight: 500;
    }

    /* Form and button alignment */
    .action-buttons form, .action-buttons button {
        margin-right: 5px;
        margin-bottom: 5px;
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .table th, .table td

    {
        padding: 8px;
        font-size: 0.9rem;
    }

    .btn-sm {
        padding: 4px 8px;
        font-size: 0.8rem;
    }

    .action-buttons form, .action-buttons button {
        display: inline-block;
        margin-bottom: 3px;
    }

    }
</style>

<div class="container-fluid">
    <h2>Quản lý mã khuyến mãi</h2>

    <p>
        <a asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Tạo mã mới</a>
    </p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Success"]</div>
    }

    <div class="table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Mã</th>
                    <th>Giảm giá</th>
                    <th>Trạng thái</th>
                    <th>Thời gian</th>
                    <th>Sử dụng</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var promo in Model)
                {
                    <tr>
                        <td>@promo.Code</td>
                        <td>
                            @if (promo.DiscountPercentage > 0)
                            {
                                <span>@promo.DiscountPercentage%</span>
                            }
                            else
                            {
                                <span>@promo.DiscountAmount.ToString("N0") VND</span>
                            }
                        </td>
                        <td>
                            <span class="badge @(promo.IsActive ? "badge-success" : "badge-danger")">
                                @(promo.IsActive ? "Kích hoạt" : "Khóa")
                            </span>
                        </td>
                        <td>
                            @if (promo.StartDate.HasValue)
                            {
                                <span>@promo.StartDate.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (promo.EndDate.HasValue)
                            {
                                <span> - @promo.EndDate.Value.ToString("dd/MM/yyyy")</span>
                            }
                        </td>
                        <td>@promo.UsageCount / @(promo.MaxUsage == 0 ? "∞" : promo.MaxUsage.ToString())</td>
                        <td class="action-buttons">
                            <a asp-action="Edit" asp-route-id="@promo.Id" class="btn btn-sm btn-warning"><i class="fas fa-edit"></i> Sửa</a>
                            <form asp-action="Delete" asp-route-id="@promo.Id" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc muốn xóa mã này?');">
                                <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i> Xóa</button>
                            </form>
                            <button class="btn btn-sm @(promo.IsActive ? "btn-danger" : "btn-success") toggle-active" data-id="@promo.Id">
                                <i class="fas @(promo.IsActive ? "fa-lock" : "fa-unlock")"></i> @(promo.IsActive ? "Khóa" : "Kích hoạt")
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('.toggle-active').click(function () {
                var id = $(this).data('id');
                $.post('@Url.Action("ToggleActive")', { id: id }, function (data) {
                    if (data.success) {
                        var btn = $(`button[data-id="${id}"]`);
                        var badge = btn.closest('tr').find('.badge');
                        var icon = btn.find('i');
                        if (data.isActive) {
                            btn.removeClass('btn-danger').addClass('btn-success').text(' Kích hoạt');
                            btn.prepend(icon.removeClass('fa-lock').addClass('fa-unlock'));
                            badge.removeClass('badge-danger').addClass('badge-success').text('Kích hoạt');
                        } else {
                            btn.removeClass('btn-success').addClass('btn-danger').text(' Khóa');
                            btn.prepend(icon.removeClass('fa-unlock').addClass('fa-lock'));
                            badge.removeClass('badge-success').addClass('badge-danger').text('Khóa');
                        }
                    } else {
                        alert(data.message);
                    }
                });
            });
        });
    </script>
}