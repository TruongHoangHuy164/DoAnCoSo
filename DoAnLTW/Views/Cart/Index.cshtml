@model List<DoAnLTW.Models.CartItem>

@{
    ViewData["Title"] = "Giỏ hàng";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<!-- Breadcrumb Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a class="breadcrumb-item text-dark" asp-controller="Shop" asp-action="Index">Sản phẩm</a>
                <span class="breadcrumb-item active">Giỏ hàng</span>
            </nav>
        </div>
    </div>
</div>
<!-- Breadcrumb End -->
<!-- Cart Start -->
<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-lg-8 table-responsive mb-5">
            @if (!Model.Any())
            {
                <p class="text-center">Giỏ hàng của bạn đang trống!</p>
            }
            else
            {
                <table class="table table-light table-borderless table-hover text-center mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>Sản phẩm</th>
                            <th>Giá</th>
                            <th>Size</th>
                            <th>Số lượng</th>
                            <th>Tổng tiền</th>
                            <th>Xóa</th>
                        </tr>
                    </thead>
                    <tbody class="align-middle">
                        @foreach (var item in Model)
                        {
                            <tr data-product-id="@item.ProductId" data-size="@item.Size">
                                <td class="align-middle">@item.ProductName</td>
                                <td class="align-middle">@item.Price.ToString("#,##0 VNĐ")</td>
                                <td class="align-middle">@item.Size</td>
                                <td class="align-middle">
                                    <div class="input-group quantity mx-auto" style="width: 100px;">
                                        <div class="input-group-btn">
                                            <a href="javascript:void(0);" class="btn btn-sm btn-primary btn-minus"
                                               data-url="@Url.Action("DecreaseQuantity", "Cart", new { productId = item.ProductId, size = item.Size })">
                                                <i class="fa fa-minus"></i>
                                            </a>
                                        </div>
                                        <input type="text" class="form-control form-control-sm bg-secondary border-0 text-center quantity-display"
                                               data-product-id="@item.ProductId" data-size="@item.Size" value="@item.Quantity" readonly>
                                        <div class="input-group-btn">
                                            <a href="javascript:void(0);" class="btn btn-sm btn-primary btn-plus"
                                               data-url="@Url.Action("IncreaseQuantity", "Cart", new { productId = item.ProductId, size = item.Size })">
                                                <i class="fa fa-plus"></i>
                                            </a>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle total-price">@((item.Price * item.Quantity).ToString("#,##0 VNĐ"))</td>
                                <td class="align-middle">
                                    <a href="javascript:void(0);" class="btn btn-sm btn-danger btn-remove"
                                       data-url="@Url.Action("RemoveFromCart", "Cart", new { productId = item.ProductId, size = item.Size })">
                                        <i class="fa fa-times"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <!-- Cart Summary -->
        <div class="col-lg-4">
            <form class="mb-30" action="">
                <div class="input-group">
                    <input type="text" class="form-control border-0 p-4" placeholder="Mã giảm giá">
                    <div class="input-group-append">
                        <button class="btn btn-primary">Áp dụng</button>
                    </div>
                </div>
            </form>

            <h5 class="section-title position-relative text-uppercase mb-3"><span class="bg-secondary pr-3">Tổng quan giỏ hàng</span></h5>
            <div class="bg-light p-30 mb-5">
                <div class="border-bottom pb-2">
                    <div class="d-flex justify-content-between mb-3">
                        <h6>Giá</h6>
                        <h6>@Model.Sum(item => item.Price * item.Quantity).ToString("#,##0 VNĐ")</h6>
                    </div>
                    <div class="d-flex justify-content-between">
                        <h6 class="font-weight-medium">Phí vận chuyển</h6>
                        <h6 class="font-weight-medium">10,000 VNĐ</h6>
                    </div>
                </div>
                <div class="pt-2">
                    <div class="d-flex justify-content-between mt-2">
                        <h5>Tổng tiền</h5>
                        <h5 class="cart-total">@((Model.Sum(item => item.Price * item.Quantity) + 10000).ToString("#,##0 VNĐ"))</h5>
                    </div>
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Checkout" asp-action="Index" class="btn btn-block btn-primary font-weight-bold my-3 py-3">
                            Thanh toán
                        </a>
                    }
                    else
                    {
                        <a href="javascript:void(0);" class="btn btn-block btn-primary font-weight-bold my-3 py-3"
                           onclick="alert('Vui lòng đăng nhập để tiếp tục thanh toán.'); window.location.href='@Url.Action("Login", "Account", new { returnUrl = Url.Action("Index", "Checkout") })';">
                            Đăng nhập để thanh toán
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Cart End -->
@section Scripts {
    <script>
        $(document).ready(function () {
            // Xử lý tăng số lượng
            $('.btn-plus').on('click', function (e) {
                e.preventDefault();
                var $this = $(this);
                var url = $this.data('url');
                var $row = $this.closest('tr');
                var $quantityInput = $row.find('.quantity-display');
                var $totalPrice = $row.find('.total-price');

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (response) {
                        if (response.success) {
                            $quantityInput.val(response.newQuantity);
                            $totalPrice.text(response.newTotal);
                            $('.cart-total').text(response.cartTotal);
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Đã có lỗi xảy ra khi tăng số lượng.');
                    }
                });
            });

            // Xử lý giảm số lượng
            $('.btn-minus').on('click', function (e) {
                e.preventDefault();
                var $this = $(this);
                var url = $this.data('url');
                var $row = $this.closest('tr');
                var $quantityInput = $row.find('.quantity-display');
                var $totalPrice = $row.find('.total-price');

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (response) {
                        if (response.success) {
                            if (response.newQuantity === 0) {
                                $row.remove();
                                if ($('.table tbody tr').length === 0) {
                                    $('.table').replaceWith('<p class="text-center">Giỏ hàng của bạn đang trống!</p>');
                                }
                            } else {
                                $quantityInput.val(response.newQuantity);
                                $totalPrice.text(response.newTotal);
                            }
                            $('.cart-total').text(response.cartTotal);
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Đã có lỗi xảy ra khi giảm số lượng.');
                    }
                });
            });

            // Xử lý xóa sản phẩm
            $('.btn-remove').on('click', function (e) {
                e.preventDefault();
                var $this = $(this);
                var url = $this.data('url');
                var $row = $this.closest('tr');

                $.ajax({
                    url: url,
                    type: 'GET',
                    success: function (response) {
                        if (response.success) {
                            $row.remove();
                            $('.cart-total').text(response.cartTotal);
                            if ($('.table tbody tr').length === 0) {
                                $('.table').replaceWith('<p class="text-center">Giỏ hàng của bạn đang trống!</p>');
                            }
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Đã có lỗi xảy ra khi xóa sản phẩm.');
                    }
                });
            });

            // Xử lý giỏ hàng trống khi nhấn thanh toán
            $('.btn-primary:contains("Thanh toán")').on('click', function (e) {
        @if (!Model.Any())
        {
            <text>
                                e.preventDefault();
                                alert('Giỏ hàng của bạn đang trống! Vui lòng thêm sản phẩm trước khi thanh toán.');
            </text>
        }
            });
        });
    </script>
}