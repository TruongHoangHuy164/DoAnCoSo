@model DoAnLTW.Controllers.ViewModels.BookHotelViewModel

@{
    ViewData["Title"] = "Đặt Phòng Khách Sạn Thú Cưng";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<h1>Đặt Phòng Khách Sạn Thú Cưng</h1>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <strong>Lỗi nhập liệu:</strong>
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<form asp-action="Book" asp-controller="PetHotelBookings" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group mb-3">
        <label asp-for="RoomTypeId" class="control-label">Loại phòng</label>
        <select asp-for="RoomTypeId" class="form-control" asp-items="@(new SelectList(Model.RoomTypes, "RoomTypeId", "Name"))" onchange="updateRooms()">
            <option value="">Chọn loại phòng</option>
        </select>
        <span asp-validation-for="RoomTypeId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="PetId" class="control-label">Thú cưng</label>
        <select asp-for="PetId" class="form-control" asp-items="@(new SelectList(Model.UserPets, "PetId", "Name"))">
            <option value="">Chọn thú cưng</option>
        </select>
        <span asp-validation-for="PetId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="StartDate" class="control-label">Ngày bắt đầu</label>
        <input asp-for="StartDate" class="form-control" type="date" onchange="updateRooms()" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="EndDate" class="control-label">Ngày kết thúc</label>
        <input asp-for="EndDate" class="form-control" type="date" onchange="updateRooms()" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="RoomId" class="control-label">Phòng trống</label>
        <div class="row" id="roomGrid">
            @foreach (var room in Model.AvailableRooms)
            {
                <div class="col-md-4 mb-3">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">Phòng @room.RoomNumber</h5>
                            <p class="card-text">Loại: @room.RoomType.Name</p>
                            <p class="card-text">Giá: @room.RoomType.PricePerNight.ToString("C")/đêm</p>
                            <div class="form-check">
                                <input type="radio" class="form-check-input" name="RoomId" id="room_@room.RoomId" value="@room.RoomId" @(Model.RoomId == room.RoomId ? "checked" : "") />
                                <label class="form-check-label" for="room_@room.RoomId">Chọn phòng này</label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <span asp-validation-for="RoomId" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Address" class="control-label">Địa chỉ nhận thú cưng</label>
        <input asp-for="Address" class="form-control" />
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Note" class="control-label">Ghi chú</label>
        <textarea asp-for="Note" class="form-control"></textarea>
        <span asp-validation-for="Note" class="text-danger"></span>
    </div>

    <div class="form-group">
        <input type="submit" value="Đặt phòng" class="btn btn-primary" />
    </div>
</form>

<style>
    .card:hover {
        border-color: #007bff;
        box-shadow: 0 0 10px rgba(0, 123, 255, 0.3);
    }

    .card .form-check {
        margin-top: 10px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        async function updateRooms() {
            const roomTypeId = document.querySelector('#RoomTypeId').value;
            const startDate = document.querySelector('#StartDate').value;
            const endDate = document.querySelector('#EndDate').value;
            const roomGrid = document.querySelector('#roomGrid');

            if (roomTypeId && startDate && endDate) {
                try {
                    const response = await fetch(`/PetHotelBookings/GetAvailableRooms?roomTypeId=${roomTypeId}&startDate=${startDate}&endDate=${endDate}`);
                    const rooms = await response.json();
                    roomGrid.innerHTML = '';
                    rooms.forEach(room => {
                        const roomHtml = `
                            <div class="col-md-4 mb-3">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h5 class="card-title">Phòng ${room.roomNumber}</h5>
                                        <p class="card-text">Loại: ${room.roomType.name}</p>
                                        <p class="card-text">Giá: ${room.roomType.pricePerNight.toLocaleString('vi-VN')}₫/đêm</p>
                                        <div class="form-check">
                                            <input type="radio" class="form-check-input" name="RoomId" id="room_${room.roomId}" value="${room.roomId}" />
                                            <label class="form-check-label" for="room_${room.roomId}">Chọn phòng này</label>
                                        </div>
                                    </div>
                                </div>
                            </div>`;
                        roomGrid.insertAdjacentHTML('beforeend', roomHtml);
                    });
                } catch (error) {
                    console.error('Lỗi khi lấy danh sách phòng:', error);
                    roomGrid.innerHTML = '<p class="text-danger">Không thể tải danh sách phòng.</p>';
                }
            } else {
                roomGrid.innerHTML = '<p class="text-muted">Vui lòng chọn loại phòng và ngày để xem phòng trống.</p>';
            }
        }
    </script>
}