@model IEnumerable<DoAnLTW.Models.PetHotelBooking>

@{
    ViewData["Title"] = "Lịch Đặt Phòng Khách Sạn";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<h1>Lịch Đặt Phòng Khách Sạn</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Thú cưng</th>
            <th>Phòng</th>
            <th>Loại phòng</th>
            <th>Ngày bắt đầu</th>
            <th>Ngày kết thúc</th>
            <th>Tổng giá</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.Pet.Name</td>
                <td>@booking.Room.RoomNumber</td>
                <td>@booking.Room.RoomType.Name</td>
                <td>@booking.StartDate.ToShortDateString()</td>
                <td>@booking.EndDate.ToShortDateString()</td>
                <td>@booking.TotalPrice.ToString("C")</td>
                <td>@booking.Status</td>
                <td>
                    <a asp-action="Cancel" asp-route-id="@booking.BookingId" class="btn btn-danger"
                       onclick="return confirm('Bạn có chắc muốn hủy đặt phòng này?');">Hủy</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Book" class="btn btn-primary">Đặt phòng mới</a>