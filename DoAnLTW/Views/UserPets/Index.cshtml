@model IEnumerable<DoAnLTW.Models.Pet>

@{
    ViewData["Title"] = "Thú cưng của tôi";
}

<style>
    /* Custom CSS for Gold, Black, and White Theme */


    h2 {
        color: #ffd700;
        text-decoration-line: 1px black;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    }

    .card {
        background-color: #2b2b2b;
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 20px rgba(255, 215, 0, 0.2);
        }

    .card-img-top {
        border-top-left-radius: 15px;
        border-top-right-radius: 15px;
        height: 200px;
        object-fit: cover;
    }

    .card-header {
        background-color: #ffd700;
        color: #000000;
        border-bottom: 1px solid #000000;
        font-weight: bold;
    }

    .card-body {
        color: #ffffff;
    }

        .card-body p {
            margin-bottom: 0.5rem;
        }

    .card-footer {
        background-color: #2b2b2b;
        border-top: 1px solid #ffd700;
    }

    .btn-outline-info {
        color: #ffd700;
        border-color: #ffd700;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .btn-outline-info:hover {
            background-color: #ffd700;
            color: #000000;
        }

    .btn-outline-primary {
        color: #ffffff;
        border-color: #ffd700;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .btn-outline-primary:hover {
            background-color: #ffd700;
            color: #000000;
        }

    .btn-outline-danger {
        color: #ffffff;
        border-color: #ff4d4d;
        transition: background-color 0.3s ease, color 0.3s ease;
    }

        .btn-outline-danger:hover {
            background-color: #ff4d4d;
            color: #ffffff;
        }

    .alert-info {
        background-color: #2b2b2b;
        color: #ffd700;
        border-color: #ffd700;
        border-radius: 10px;
    }

    .btn-primary {
        background-color: #ffd700;
        border-color: #ffd700;
        color: #000000;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .btn-primary:hover {
            background-color: #e6c200;
            transform: scale(1.05);
        }

    .btn-group .btn {
        margin: 0 5px;
        border-radius: 8px;
    }

    i.fas {
        margin-right: 0.5rem;
    }

    @@media (max-width: 768px) {
        .card

    {
        margin-bottom: 1.5rem;
    }

    .btn-group .btn {
        font-size: 0.9rem;
        padding: 0.5rem;
    }

    }
</style>

<div class="container-fluid pt-5">
    <div class="row px-xl-5">
        <div class="col-12">
            <div class="d-flex justify-content-between mb-4">
                <h2>Thú cưng của tôi</h2>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus mr-1"></i> Thêm thú cưng mới
                </a>
            </div>

            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle mr-2"></i> Bạn chưa có thú cưng nào. Hãy thêm thú cưng để sử dụng dịch vụ.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var pet in Model)
                    {
                        var mainImage = pet.Images?.FirstOrDefault(img => img.IsMainImage)?.ImageUrl ?? "/images/default-pet.jpg";
                        <div class="col-md-4 mb-4">
                            <div class="card h-100">
                                <img src="@mainImage" class="card-img-top" alt="@pet.Name" style="height: 200px; object-fit: cover;" />
                                <div class="card-header bg-light">
                                    <h5 class="mb-0">@pet.Name</h5>
                                </div>
                                <div class="card-body">
                                    <p><strong><i class="fas fa-paw mr-2"></i>Loại:</strong> @pet.Type</p>
                                    <p><strong><i class="fas fa-tag mr-2"></i>Giống:</strong> @(pet.Breed ?? "Không có")</p>
                                    <p><strong><i class="fas fa-birthday-cake mr-2"></i>Tuổi:</strong> @pet.Age</p>
                                    @if (!string.IsNullOrEmpty(pet.Description))
                                    {
                                        <p><strong><i class="fas fa-sticky-note mr-2"></i>Ghi chú:</strong> @pet.Description</p>
                                    }
                                </div>
                                <div class="card-footer">
                                    <div class="btn-group w-100">
                                        <a asp-action="Detail" asp-route-id="@pet.PetId" class="btn btn-outline-info">
                                            <i class="fas fa-eye mr-1"></i> Xem Chi Tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@pet.PetId" class="btn btn-outline-primary">
                                            <i class="fas fa-edit mr-1"></i> Sửa
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@pet.PetId" class="btn btn-outline-danger">
                                            <i class="fas fa-trash mr-1"></i> Xóa
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script> <!-- Font Awesome for icons -->
}