    <!-- Search and Voice Search Script -->
    <script>
               $(document).ready(function () {
            // Gợi ý tìm kiếm (unchanged)
            let debounceTimer;
            $('#searchInput').on('input', function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    var searchString = $(this).val().trim();
                    if (searchString.length < 2) {
                        $('#searchSuggestions').hide();
                        return;
                    }
                    $.ajax({
                        url: '/Shop/SearchSuggestions',
                        type: 'GET',
                        data: { searchString: searchString },
                        success: function (data) {
                            if (data.length > 0) {
                                var suggestionsHtml = '';
                                data.forEach(function (product) {
                                    suggestionsHtml += `
                                        <div class="search-suggestion-item" onclick="window.location.href='/Shop/Details/${product.productId}'">
                                            <img src="${product.imageUrl || '/img/default-product.jpg'}" alt="${product.name}" />
                                            <div>
                                                <div>${product.name}</div>
                                                <div>${product.minPrice.toLocaleString('vi-VN')} VNĐ</div>
                                            </div>
                                        </div>`;
                                });
                                $('#searchSuggestions').html(suggestionsHtml).show();
                            } else {
                                $('#searchSuggestions').html('<div class="search-suggestion-item">Không tìm thấy sản phẩm</div>').show();
                            }
                        },
                        error: function () {
                            $('#searchSuggestions').html('<div class="search-suggestion-item">Đã có lỗi xảy ra</div>').show();
                        }
                    });
                }, 300);
            });

            // Ẩn gợi ý khi click ra ngoài
            $(document).click(function (e) {
                if (!$(e.target).closest('.search-container').length) {
                    $('#searchSuggestions').hide();
                }
            });

            // Tìm kiếm bằng giọng nói
            function initializeSpeechRecognition() {
                const micButton = document.getElementById('micButton');
                const searchInput = document.getElementById('searchInput');
                let recognition = null;

                if ('SpeechRecognition' in window || 'webkitSpeechRecognition' in window) {
                    recognition = new (window.SpeechRecognition || window.webkitSpeechRecognition)();
                    recognition.lang = 'vi-VN';
                    recognition.interimResults = false;
                    recognition.maxAlternatives = 1;

                    micButton.addEventListener('click', () => {
                        if (micButton.classList.contains('recording')) {
                            recognition.stop();
                        } else {
                            try {
                                recognition.start();
                                micButton.classList.add('recording');
                                micButton.querySelector('i').classList.remove('fa-microphone');
                                micButton.querySelector('i').classList.add('fa-stop');
                            } catch (e) {
                                alert('Không thể bắt đầu nhận diện giọng nói: ' + e.message);
                            }
                        }
                    });

                    recognition.onresult = (event) => {
                        const transcript = event.results[0][0].transcript;
                        if (transcript.trim()) {
                            searchInput.value = transcript;
                            searchInput.closest('form').submit();
                        } else {
                            alert('Không nhận diện được giọng nói. Vui lòng thử lại.');
                        }
                    };

                    recognition.onend = () => {
                        micButton.classList.remove('recording');
                        micButton.querySelector('i').classList.remove('fa-stop');
                        micButton.querySelector('i').classList.add('fa-microphone');
                    };

                    recognition.onerror = (event) => {
                        let errorMessage = 'Đã xảy ra lỗi khi nhận diện giọng nói: ';
                        switch (event.error) {
                            case 'no-speech':
                                errorMessage += 'Không nhận diện được giọng nói. Vui lòng thử lại.';
                                break;
                            case 'not-allowed':
                                errorMessage += 'Microphone bị từ chối. Vui lòng cấp quyền truy cập microphone.';
                                break;
                            case 'network':
                                errorMessage += 'Lỗi mạng. Vui lòng kiểm tra kết nối internet.';
                                break;
                            default:
                                errorMessage += event.error;
                        }
                        alert(errorMessage);
                        micButton.classList.remove('recording');
                        micButton.querySelector('i').classList.remove('fa-stop');
                        micButton.querySelector('i').classList.add('fa-microphone');
                    };
                } else {
                    micButton.disabled = true;
                    micButton.title = 'Trình duyệt không hỗ trợ tìm kiếm bằng giọng nói';
                    micButton.style.opacity = '0.5';
                    micButton.style.cursor = 'not-allowed';
                    console.log('SpeechRecognition not supported in this browser.');
                }
            }

            initializeSpeechRecognition();
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
