@{
    ViewData["Title"] = "Home Page";
}

<!-- AOS CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css" integrity="sha512-1cK78a1o+ht2JcaW6g8OXYwqpev9+6GqOkz9xmBN9iUUhIndKtxwILGWYOSibOKjLsEdGeHiw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

<!-- Floating Button -->
<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap');

    body {
        font-family: 'Poppins', sans-serif;
    }

    .floating-promo-btn {
        position: fixed;
        bottom: 30px;
        left: 30px;
        z-index: 1000;
        background: linear-gradient(135deg, #00C9FF, #92FE9D);
        color: white;
        padding: 12px 24px;
        border-radius: 30px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
    }

        .floating-promo-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2);
        }

    .promo-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.08);
        padding: 20px;
        text-align: center;
        margin: 15px;
        transition: transform 0.3s ease;
    }

        .promo-card:hover {
            transform: scale(1.02);
        }

    .promo-code {
        font-size: 1.6rem;
        font-weight: 600;
        color: #4CAF50;
        margin-bottom: 12px;
    }

    .promo-description {
        font-size: 1rem;
        color: #444;
        margin-bottom: 8px;
    }

    .promo-expiry {
        font-size: 0.9rem;
        color: #999;
    }

    .vendor-carousel .bg-light {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 120px;
    }

    .vendor-carousel img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .product-carousel .product-item {
        background: #FFFFFF;
        margin: 0 10px;
        padding: 15px;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease;
    }

        .product-carousel .product-item:hover {
            transform: scale(1.05);
        }

    .product-carousel .product-img {
        width: 100%;
        height: auto;
        aspect-ratio: 1 / 1;
        overflow: hidden;
    }

        .product-carousel .product-img img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

    .product-carousel .product-action {
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .product-carousel .product-item:hover .product-action {
        opacity: 1;
    }

    .promo-carousel .promo-card {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        padding: 15px;
        text-align: center;
        margin: 10px;
    }
</style>

<!-- Floating Button with AOS -->
<a href="#promo-section" class="floating-promo-btn" data-aos="fade-up" data-aos-delay="100" data-aos-once="true">!Mã Khuyến Mãi!</a>

<!-- Carousel Start -->
<div class="container-fluid mb-3" data-aos="fade-in" data-aos-delay="200" data-aos-once="true">
    <div class="row px-xl-5">
        <div class="col-lg-8">
            <div id="header-carousel" class="carousel slide carousel-fade mb-30 mb-lg-0" data-ride="carousel">
                <ol class="carousel-indicators">
                    <li data-target="#header-carousel" data-slide-to="0" class="active"></li>
                    <li data-target="#header-carousel" data-slide-to="1"></li>
                    <li data-target="#header-carousel" data-slide-to="2"></li>
                </ol>
                <div class="carousel-inner">
                    <div class="carousel-item position-relative active" style="height: 430px;">
                        <img class="position-absolute w-100 h-100" src="~/img/slider1.jpg" style="object-fit: cover;" alt="Slider 1">
                        <div class="carousel-caption d-flex flex-column align-items-center justify-content-center" data-aos="fade-up" data-aos-delay="300" data-aos-once="true">
                            <div class="p-3" style="max-width: 700px;">
                                <h1 class="display-4 text-white mb-3 animate__animated animate__fadeInDown">Yêu Boss Hết Mình</h1>
                                <p class="mx-md-5 px-5 animate__animated animate__bounceIn">Từ thức ăn đến đồ chơi, mọi thứ boss cần đều có tại shop! 🐶🐱 Phục vụ boss chuẩn chỉnh – làm sen chuẩn gu!</p>
                                <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp">Khám Phá Ngay</a>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item position-relative" style="height: 430px;">
                        <img class="position-absolute w-100 h-100" src="~/img/slider2.jpg" style="object-fit: cover;" alt="Slider 2">
                        <div class="carousel-caption d-flex flex-column align-items-center justify-content-center" data-aos="fade-up" data-aos-delay="300" data-aos-once="true">
                            <div class="p-3" style="max-width: 700px;">
                                <h1 class="display-4 text-white mb-3 animate__animated animate__fadeInDown">Sống Chất Cùng Boss</h1>
                                <p class="mx-md-5 px-5 animate__animated animate__bounceIn">Thời trang, phong cách, đậm cá tính – boss ra đường phải nổi bật nhất khu luôn nha! 🐾✨</p>
                                <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp">Xem Ngay</a>
                            </div>
                        </div>
                    </div>
                    <div class="carousel-item position-relative" style="height: 430px;">
                        <img class="position-absolute w-100 h-100" src="~/img/slider3.jpg" style="object-fit: cover;" alt="Slider 3">
                        <div class="carousel-caption d-flex flex-column align-items-center justify-content-center" data-aos="fade-up" data-aos-delay="300" data-aos-once="true">
                            <div class="p-3" style="max-width: 700px;">
                                <h1 class="display-4 text-white mb-3 animate__animated animate__fadeInDown">Boss Vui, Sen Mới Chill</h1>
                                <p class="mx-md-5 px-5 animate__animated animate__bounceIn">Giúp boss khỏe mạnh, vui vẻ mỗi ngày với sản phẩm chất lượng – yêu thương từ những điều nhỏ nhất 🐕💖</p>
                                <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-light py-2 px-4 mt-3 animate__animated animate__fadeInUp">Mua Ngay</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Giảm giá -->
        <div class="col-lg-4">
            <div class="product-offer mb-30" style="height: 200px;" data-aos="zoom-in" data-aos-delay="400" data-aos-once="true">
                <img class="img-fluid" src="~/img/giamgia1.jpg" alt="Giảm giá 1">
                <div class="offer-text">
                    <h6 class="text-white text-uppercase">Save 20%</h6>
                    <h3 class="text-white mb-3">Special Offer</h3>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Shop Now</a>
                </div>
            </div>
            <div class="product-offer mb-30" style="height: 200px;" data-aos="zoom-in" data-aos-delay="500" data-aos-once="true">
                <img class="img-fluid" src="~/img/giamgia2.jpg" alt="Giảm giá 2">
                <div class="offer-text">
                    <h6 class="text-white text-uppercase">Save 20%</h6>
                    <h3 class="text-white mb-3">Special Offer</h3>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Shop Now</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Carousel End -->
<!-- Tiêu chí Start -->
<div class="container-fluid pt-5" data-aos="fade-up" data-aos-delay="600" data-aos-once="true">
    <div class="row px-xl-5 pb-3">
        <div class="col-lg-3 col-md-6 col-sm-12 pb-1" data-aos="fade-up" data-aos-delay="700" data-aos-once="true">
            <div class="d-flex align-items-center bg-light mb-4" style="padding: 30px;">
                <h1 class="fa fa-check text-primary m-0 mr-3"></h1>
                <h5 class="font-weight-semi-bold m-0">Sản phẩm chất lượng</h5>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12 pb-1" data-aos="fade-up" data-aos-delay="800" data-aos-once="true">
            <div class="d-flex align-items-center bg-light mb-4" style="padding: 30px;">
                <h1 class="fa fa-shipping-fast text-primary m-0 mr-2"></h1>
                <h5 class="font-weight-semi-bold m-0">Giao hàng miễn phí</h5>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12 pb-1" data-aos="fade-up" data-aos-delay="900" data-aos-once="true">
            <div class="d-flex align-items-center bg-light mb-4" style="padding: 30px;">
                <h1 class="fas fa-exchange-alt text-primary m-0 mr-3"></h1>
                <h5 class="font-weight-semi-bold m-0">1 đổi 1 trong 14 ngày</h5>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-sm-12 pb-1" data-aos="fade-up" data-aos-delay="1000" data-aos-once="true">
            <div class="d-flex align-items-center bg-light mb-4" style="padding: 30px;">
                <h1 class="fa fa-phone-volume text-primary m-0 mr-3"></h1>
                <h5 class="font-weight-semi-bold m-0">Hỗ trợ 24/7</h5>
            </div>
        </div>
    </div>
</div>
<!-- Tiêu chí End -->
<!-- Promotion Codes Start -->
<div id="promo-section" class="container-fluid pt-5 pb-3" data-aos="fade-in" data-aos-delay="1100" data-aos-once="true">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4" data-aos="fade-up" data-aos-delay="1200" data-aos-once="true">
        <span class="bg-secondary pr-3">Mã Khuyến Mãi</span>
    </h2>
    <div class="row px-xl-5">
        <div class="col">
            <div class="owl-carousel promo-carousel">
                @foreach (var promo in Model.PromotionCodes)
                {
                    <div class="promo-card" data-aos="zoom-in" data-aos-delay="1300" data-aos-once="true">
                        <div class="promo-code">@promo.Code</div>
                        <div class="promo-description">
                            @(promo.DiscountPercentage > 0 ? $"Giảm {promo.DiscountPercentage}%" : $"Giảm {promo.DiscountAmount.ToString("#,##0 VNĐ")}")
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Promotion Codes End -->
<!-- Vendor Start Category -->
<div class="container-fluid py-5" data-aos="fade-in" data-aos-delay="1400" data-aos-once="true">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4" data-aos="fade-up" data-aos-delay="1500" data-aos-once="true">
        <span class="bg-secondary pr-3">Danh Mục Sản Phẩm</span>
    </h2>
    <div class="row px-xl-5">
        <div class="col">
            <div class="owl-carousel vendor-carousel">
                @foreach (var category in Model.Categories)
                {
                    <div class="bg-light p-4" data-aos="zoom-in" data-aos-delay="1600" data-aos-once="true">
                        <img src="@category.ImageUrl" alt="@category.Name" loading="lazy">
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Sản phẩm nổi bật Start -->
<div class="container-fluid pt-5 pb-3" data-aos="fade-in" data-aos-delay="1700" data-aos-once="true">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4" data-aos="fade-up" data-aos-delay="1800" data-aos-once="true">
        <span class="bg-secondary pr-3">Sản phẩm nổi bật</span>
    </h2>
    <div class="row px-xl-5">
        <div class="col">
            <div class="owl-carousel product-carousel">
                @foreach (var productWithMinPrice in Model.ProductsWithMinPrice)
                {
                    <div class="product-item bg-light mb-4" data-aos="zoom-in" data-aos-delay="1900" data-aos-once="true">
                        <div class="product-img position-relative overflow-hidden">
                            <img class="img-fluid w-100" src="@productWithMinPrice.Product.ImageUrl" alt="@productWithMinPrice.Product.Name">
                            <div class="product-action">
                                <a class="btn btn-outline-dark btn-square" href="#" onclick="toggleFavourite(@productWithMinPrice.Product.ProductId); return false;"><i class="far fa-heart"></i></a>
                                <a asp-controller="Shop" asp-action="Details" asp-route-id="@productWithMinPrice.Product.ProductId" class="btn btn-outline-dark btn-square"><i class="fa fa-search"></i></a>
                            </div>
                        </div>
                        <div class="text-center py-4">
                            <a class="h6 text-decoration-none text-truncate" asp-controller="Shop" asp-action="Details" asp-route-id="@productWithMinPrice.Product.ProductId">@productWithMinPrice.Product.Name</a>
                            <div class="d-flex align-items-center justify-content-center mt-2">
                                <h5>@productWithMinPrice.MinPrice.ToString("#,##0 VNĐ")</h5>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Sản phẩm nổi bật End -->
<!-- Giảm giá Start -->
<div class="container-fluid pt-5 pb-3" data-aos="fade-in" data-aos-delay="2000" data-aos-once="true">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4" data-aos="fade-up" data-aos-delay="2100" data-aos-once="true">
        <span class="bg-secondary pr-3">Sản phẩm Giảm giá</span>
    </h2>
    <div class="row px-xl-5">
        <div class="col-md-6" data-aos="zoom-in" data-aos-delay="2200" data-aos-once="true">
            <div class="product-offer mb-30" style="height: 300px;">
                <img class="img-fluid" src="~/img/giamgia1.jpg" alt="Giảm giá 1">
                <div class="offer-text">
                    <h6 class="text-white text-uppercase">Save 20%</h6>
                    <h3 class="text-white mb-3">Special Offer</h3>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Shop Now</a>
                </div>
            </div>
        </div>
        <div class="col-md-6" data-aos="zoom-in" data-aos-delay="2300" data-aos-once="true">
            <div class="product-offer mb-30" style="height: 300px;">
                <img class="img-fluid" src="~/img/giamgia2.jpg" alt="Giảm giá 2">
                <div class="offer-text">
                    <h6 class="text-white text-uppercase">Save 20%</h6>
                    <h3 class="text-white mb-3">Special Offer</h3>
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-primary">Shop Now</a>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Giảm giá End -->
<!-- Vendor Start (for Brands) -->
<div class="container-fluid py-5" data-aos="fade-in" data-aos-delay="2400" data-aos-once="true">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4" data-aos="fade-up" data-aos-delay="2500" data-aos-once="true">
        <span class="bg-secondary pr-3">Thương Hiệu Hợp tác</span>
    </h2>
    <div class="row px-xl-5">
        <div class="col">
            <div class="owl-carousel vendor-carousel">
                @foreach (var brand in Model.Brands)
                {
                    <div class="bg-light p-4" data-aos="zoom-in" data-aos-delay="2600" data-aos-once="true">
                        <img src="@brand.ImageUrl" alt="@brand.Name" loading="lazy">
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Vendor End -->
<!-- Scripts Section -->
@section Scripts {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/assets/owl.theme.default.min.css" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/OwlCarousel2/2.3.4/owl.carousel.min.js" defer></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js" integrity="sha512-A7AYk1fGKX6S2SsHywmPkrnzTZHrgiVT7GcQkLGDe2ev0aWb8zejytzS8wjo7PGEXKqJOrjQ4oORtnimIRZBtw==" crossorigin="anonymous" referrerpolicy="no-referrer" defer></script>

    <script>
        $(document).ready(function () {
            // Initialize AOS
            AOS.init({
                duration: 800, // Animation duration in milliseconds
                easing: 'ease-in-out', // Smooth easing for animations
                once: true // Animations happen only once
            });

            // Initialize Owl Carousel for Categories
            $('.vendor-carousel').owlCarousel({
                loop: true,
                margin: 10,
                nav: false,
                autoplay: true,
                autoplayTimeout: 3000,
                autoplayHoverPause: true,
                responsive: {
                    0: { items: 1 },
                    600: { items: 3 },
                    1000: { items: 5 }
                }
            });

            // Initialize Owl Carousel for Featured Products
            $('.product-carousel').owlCarousel({
                loop: true,
                margin: 10,
                nav: false,
                autoplay: true,
                autoplayTimeout: 4000,
                autoplayHoverPause: true,
                responsive: {
                    0: { items: 1 },
                    600: { items: 2 },
                    1000: { items: 4 }
                }
            });

            // Initialize Owl Carousel for Promotions
            $('.promo-carousel').owlCarousel({
                loop: true,
                margin: 10,
                nav: false,
                autoplay: true,
                autoplayTimeout: 3500,
                autoplayHoverPause: true,
                responsive: {
                    0: { items: 1 },
                    600: { items: 2 },
                    1000: { items: 4 }
                }
            });

            // Smooth scroll to promo section
            $('.floating-promo-btn').click(function (e) {
                e.preventDefault();
                $('html, body').animate({
                    scrollTop: $('#promo-section').offset().top
                }, 800);
            });
        });

        // Xử lý thêm/xóa yêu thích
        function toggleFavourite(productId) {
            $.ajax({
                url: '/Shop/ToggleFavourite',
                type: 'POST',
                data: {
                    productId: productId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (!response.success && response.message) {
                        alert(response.message);
                        return;
                    }
                    if (response.success) {
                        let heartIcon = $(`[onclick='toggleFavourite(${productId})'] i`);
                        if (response.isAdded) {
                            heartIcon.removeClass('far').addClass('fas text-danger');
                            alert("Đã thêm vào danh sách yêu thích!");
                        } else {
                            heartIcon.removeClass('fas text-danger').addClass('far');
                            alert("Đã xóa khỏi danh sách yêu thích!");
                        }
                        $('#favouriteCount').text(response.count); // Cập nhật số lượng yêu thích nếu có
                    } else {
                        alert("Không thể cập nhật danh sách yêu thích!");
                    }
                },
                error: function () {
                    alert("Lỗi kết nối. Vui lòng kiểm tra mạng và thử lại.");
                }
            });
        }
    </script>
}